<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- NuGet Configuration for Security and Package Management -->
  
  <!-- Package Sources Configuration -->
  <packageSources>
    <clear />
    <!-- Official NuGet source for verified packages -->
    <add key="nuget" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Package Source Mapping: restrict where packages can come from (requires NuGet 6.5+) -->
  <!-- This prevents dependency confusion attacks by binding packages to specific sources -->
  <packageSourceMapping>
    <packageSource key="nuget">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!-- Credential Storage: use secure credential providers -->
  <credentialProvider>
    <credentialProviders>
      <credentialProvider assemblyName="NuGet.CredentialProvider.VSS.CredentialProvider, Version=1.0.0.0, Culture=neutral" />
    </credentialProviders>
  </credentialProvider>

  <!-- Disable untrusted sources to prevent man-in-the-middle attacks -->
  <config>
    <add key="defaultPushSource" value="https://api.nuget.org/v3/index.json" />
  </config>
</configuration>
